PORT=3000

# --- Security checks ---
# VirusTotal API key (free: 4 requests/min)  https://www.virustotal.com/gui/my-apikey
VT_API_KEY=
# URLhaus Auth-Key from abuse.ch (free)      https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# --- Company verification ---
# Google Cloud key with "Places API (New)" enabled
GOOGLE_PLACES_KEY=

# --- AI reading of the job description ---
# The provider to use for AI reading ("gemini" or "anthropic")
LLM_PROVIDER=gemini
# Your Google Gemini API key
GEMINI_API_KEY=
# Your Anthropic API key
ANTHROPIC_API_KEY=
# The specific model to use for the selected provider (e.g. gemini-flash-lite-latest, gemini-3.1-flash-lite, or claude-3-haiku-20240307)
LLM_MODEL=

# --- Optional: anchor each report hash on a public chain (Sepolia testnet) ---
# Use a NEW throwaway wallet funded with free Sepolia ETH. Never use a real wallet.
ANCHOR_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ANCHOR_PRIVATE_KEY=


# --- Supabase ---
# The URL of your Supabase project
SUPABASE_URL=
# The public anon key (safe for browser if needed)
SUPABASE_PUBLISHABLE_KEY=
# The service role key (NEVER expose to browser)
SUPABASE_SECRET_KEY=

# --- Reverse Proxy ---
# Set TRUST_PROXY=1 (or security.trustProxy in config/runtime.json) when deployed behind a proxy so rate limits use the client IP
TRUST_PROXY=
